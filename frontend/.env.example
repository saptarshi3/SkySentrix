# SkySentrix Frontend Environment Configuration

# Backend API base URL
# Local Development:
VITE_API_URL=http://localhost:8000

# Production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://<your-render-backend-name>.onrender.com

# Optional WebSocket URL override:
# If omitted, it is automatically derived from VITE_API_URL (http->ws, https->wss)
# VITE_WS_URL=wss://<your-render-backend-name>.onrender.com/ws/telemetry
