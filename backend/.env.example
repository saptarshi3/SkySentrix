# SkySentrix Backend Environment Configuration

# Server binding (Render sets PORT automatically)
PORT=8000
HOST=0.0.0.0

# CORS Configuration
# In production, set to your Vercel deployment URL(s), comma-separated:
# CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to allow all origins during initial preview/testing
CORS_ALLOW_ALL=true

# Database URL override (defaults to sqlite:///skysentrix.db inside backend/)
# DATABASE_URL=sqlite:///skysentrix.db
